generator client {
  provider = "prisma-client-js"
  output   = "../api/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  skates
  skateboard
  longboard
}

enum SensorSource {
  phone
  external
}

model Ride {
  id            String       @id
  startedAt     DateTime     @map("started_at")
  endedAt       DateTime?    @map("ended_at")
  vehicleType   VehicleType  @map("vehicle_type")
  sensorSource  SensorSource @map("sensor_source")
  clientId      String?      @map("client_id")
  appVersion    String?      @map("app_version")
  deviceModel   String?      @map("device_model")
  sampleCount   Int          @default(0) @map("sample_count")
  gpsPointCount Int          @default(0) @map("gps_point_count")
  avgVibration  Float?       @map("avg_vibration")
  maxVibration  Float?       @map("max_vibration")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  samples       Sample[]

  @@index([startedAt(sort: Desc)])
  @@map("rides")
}

model Sample {
  id                 BigInt   @id @default(autoincrement())
  rideId             String   @map("ride_id")
  recordedAt         DateTime @map("recorded_at")
  ax                 Float
  ay                 Float
  az                 Float
  gx                 Float
  gy                 Float
  gz                 Float
  vibrationMagnitude Float    @map("vibration_magnitude")
  latitude           Float?
  longitude          Float?
  speed              Float?
  createdAt          DateTime @default(now()) @map("created_at")
  ride               Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, recordedAt])
  @@map("samples")
}
