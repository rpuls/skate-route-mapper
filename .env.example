POSTGRES_DB=skate_route_mapper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

API_PORT=3001
ADMIN_PORT=3000
DATABASE_URL=postgres://postgres:postgres@db:5432/skate_route_mapper
CORS_ORIGIN=http://localhost:3000
MOBILE_INGESTION_API_KEY=local-dev-mobile-ingestion-key
ADMIN_API_KEY=local-dev-admin-dashboard-key
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=local-dev-admin-password
ADMIN_SESSION_TTL_HOURS=24

VITE_API_BASE_URL=http://localhost:3001

# Where `npm run research:fetch` pulls the research dataset from, and the key it
# uses. Point these at the deployed API to fetch real captures.
#
# RESEARCH_API_KEY is read before ADMIN_API_KEY on purpose: ADMIN_API_KEY above
# belongs to the local Docker stack, and overwriting it with the deployed key to
# run one fetch would quietly change what `npm run app` runs with. Set the
# deployed service's admin key here instead and leave the local one alone.
#
# Both fall back: the URL to VITE_API_BASE_URL and then localhost, the key to
# ADMIN_API_KEY. Unset, the fetch reads the local stack.
RESEARCH_API_BASE_URL=http://localhost:3001
RESEARCH_API_KEY=
