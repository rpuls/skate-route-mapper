{
  "expo": {
    "name": "skate-route-mapper",
    "slug": "skate-route-mapper",
    "scheme": "skate-route-mapper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rasmuspuls.skateroutemapper",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Skate Route Mapper connects to external BLE IMU sensors for accelerometer and gyroscope data.",
        "NSCameraUsageDescription": "Skate Route Mapper attaches a surface photo to a research collection.",
        "NSLocationWhenInUseUsageDescription": "Skate Route Mapper records the location of rides and research collections.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.timmosquadros.skateroutemapper",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Skate Route Mapper to photograph the surface for a research collection."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Skate Route Mapper to record the location of rides and research collections."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Skate Route Mapper connects to external BLE IMU sensors for accelerometer and gyroscope data."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c768e1c4-de83-419d-9f53-8a3efe9521c3"
      }
    }
  }
}
