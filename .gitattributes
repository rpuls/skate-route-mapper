# Normalize line endings so two developers on different machines and git configs
# cannot introduce churn. Text files are stored LF in the repository and checked
# out using the platform's convention.
* text=auto

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# Arduino sketches and firmware sources stay LF.
*.ino text eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.node binary
*.wasm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.skateresearch binary
