generator client {
  provider = "prisma-client-js"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  skates
  skateboard
  longboard
}

enum SensorSource {
  phone
  external
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String?
  active       Boolean        @default(true)
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@index([active])
  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String                @map("password_hash")
  name                 String?
  lastLoginAt          DateTime?             @map("last_login_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  sessions             UserSession[]
  devices              Device[]
  rides                Ride[]
  syncOperations       SyncOperation[]
  experimentalCaptures ExperimentalCapture[]

  @@map("users")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Device {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  clientId    String?  @unique @map("client_id")
  deviceModel String?  @map("device_model")
  appVersion  String?  @map("app_version")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rides       Ride[]

  @@index([userId])
  @@map("devices")
}

model Ride {
  id            String       @id
  userId        String?      @map("user_id")
  deviceId      String?      @map("device_id")
  startedAt     DateTime     @map("started_at")
  endedAt       DateTime?    @map("ended_at")
  vehicleType   VehicleType  @map("vehicle_type")
  sensorSource  SensorSource @map("sensor_source")
  clientId      String?      @map("client_id")
  appVersion    String?      @map("app_version")
  deviceModel   String?      @map("device_model")
  sampleCount   Int          @default(0) @map("sample_count")
  gpsPointCount Int          @default(0) @map("gps_point_count")
  avgVibration  Float?       @map("avg_vibration")
  maxVibration  Float?       @map("max_vibration")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  device        Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  samples       Sample[]

  @@index([userId])
  @@index([deviceId])
  @@index([startedAt(sort: Desc)])
  @@map("rides")
}

model Sample {
  id                 BigInt    @id @default(autoincrement())
  rideId             String    @map("ride_id")
  recordedAt         DateTime  @map("recorded_at")
  ax                 Float
  ay                 Float
  az                 Float
  gx                 Float
  gy                 Float
  gz                 Float
  vibrationMagnitude Float     @map("vibration_magnitude")
  latitude           Float?
  longitude          Float?
  speed              Float?
  locationTimestamp  DateTime? @map("location_timestamp")
  locationAccuracy   Float?    @map("location_accuracy")
  locationAgeMs      Int?      @map("location_age_ms")
  createdAt          DateTime  @default(now()) @map("created_at")
  ride               Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, recordedAt])
  @@map("samples")
}

model SyncOperation {
  id            String   @id @map("id")
  userId        String?  @map("user_id")
  operationType String   @map("operation_type")
  createdAtMs   BigInt   @map("created_at_ms")
  processedAt   DateTime @default(now()) @map("processed_at")
  payload       Json
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([processedAt])
  @@map("sync_operations")
}

model ExperimentalCapture {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("experimental_captures")
}
