{
  "name": "@skate-route-mapper/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy --schema ../db/schema.prisma && node dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "contracts:test": "tsc -p test/contracts/tsconfig.json --noEmit && tsx --test test/contracts/mobileRideContracts.contract.test.ts",
    "prisma:generate": "prisma generate --schema ../db/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ../db/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../db/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.18.0",
    "@skate-route-mapper/shared": "*",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "prisma": "^6.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
