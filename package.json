{
  "name": "skate-route-mapper-monorepo",
  "private": true,
  "workspaces": [
    "api",
    "admin",
    "mobile",
    "shared"
  ],
  "scripts": {
    "admin-app": "npm run docker:up",
    "app": "npm run admin-app",
    "stop": "npm run docker:down",
    "logs": "npm run docker:logs",
    "mobile:start": "cd mobile && npx expo start",
    "mobile:expogo": "cd mobile && npx expo start --lan",
    "mobile:tunnel": "cd mobile && npx expo start --tunnel",
    "mobile:android": "cd mobile && npx expo start --android",
    "mobile:ios": "cd mobile && npx expo start --ios",
    "mobile:web": "cd mobile && npx expo start --web",
    "admin:dev": "npm run dev --workspace @skate-route-mapper/admin",
    "admin:build": "npm run build --workspace @skate-route-mapper/admin",
    "admin:preview": "npm run preview --workspace @skate-route-mapper/admin",
    "api:dev": "npm run dev --workspace @skate-route-mapper/api",
    "api:build": "npm run build --workspace @skate-route-mapper/api",
    "api:start": "npm run start --workspace @skate-route-mapper/api",
    "api:check": "npm run check --workspace @skate-route-mapper/api",
    "db:generate": "npm run prisma:generate --workspace @skate-route-mapper/api",
    "db:migrate:dev": "npm run prisma:migrate:dev --workspace @skate-route-mapper/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @skate-route-mapper/api",
    "docker:up": "docker compose up --build --detach --wait && node scripts/docker-ready.mjs",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "overrides": {
    "react-dom": "19.1.0"
  }
}
