# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
logs/
*.log

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
.metro-cache/
metro-cache/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env.*.local
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
/mobile/android
/mobile/ios

# Gradle output inside the hand-written background-recorder module. The module's
# android/ directory is source, not prebuild output, so it must stay tracked.
/mobile/modules/background-recorder/android/build/
/mobile/modules/background-recorder/android/.gradle/

# Coverage
coverage/

# Test artifacts
test-results/
playwright-report/

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp

# Generated files
*.zip
*.tar
*.gz
backend/generated/
# Shared compiled for production only; every other consumer reads shared/src.
shared/dist/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Misc
Thumbs.db
results.bin

# Design system sync tooling and generated bundle
.ds-sync/
.design-sync/
ds-bundle/

# Playwright MCP session dumps
.playwright-mcp/

# Research dataset pulled down by `npm run research:fetch`. Recordings and
# surface photos are large, they already live in the database, and the fetch is
# one command away, so they are never committed.
research-data/

# Python analysis artifacts
__pycache__/
*.pyc
